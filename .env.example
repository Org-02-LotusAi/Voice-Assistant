# SAFI Service 015 - copy to .env and fill in. Never commit .env.

# API keys for the control plane: comma-separated "key:role" pairs.
# Roles: admin, operator, viewer (admin > operator > viewer).
SERVICE015_API_KEYS=change-me-admin-key:admin,change-me-operator-key:operator,change-me-viewer-key:viewer
# Bootstrap password for the first human account (username `admin`). Used only when no admin exists yet; the account must change
# it on first login. At least 12 characters, not a common password. REQUIRED when SERVICE015_PUBLIC_URL is not localhost; on
# localhost it may be left empty (then only API keys can sign in). Generate: python -c "import secrets; print(secrets.token_urlsafe(18))"
SERVICE015_ADMIN_PASSWORD=change-me-admin-password
# SQLite database file (parent directory is created automatically).
SERVICE015_DB_PATH=./data/service015.db
SERVICE015_HOST=127.0.0.1
SERVICE015_PORT=8015
# Externally reachable base URL of this service.
SERVICE015_PUBLIC_URL=http://localhost:8015

# OpenAI-compatible LLM endpoint.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
# Sent as reasoning_effort on chat requests (none keeps first-token latency ~1 s); leave empty to omit the field.
LLM_REASONING_EFFORT=none

# LiveKit server (dev defaults).
LIVEKIT_URL=ws://localhost:7880
# devkey/secret are the dev-server defaults for a laptop. Any non-local deployment MUST use generated values
# (docker-compose.yml refuses to start without them; see deploy/EC2.md for a one-liner).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# docker compose only: how the service015 container reaches LiveKit (default ws://livekit:7880; LiveKit Cloud: the wss URL).
# LIVEKIT_INTERNAL_URL=ws://livekit:7880
# URL handed to browsers in join tokens and the UI CSP when it differs from LIVEKIT_URL (Docker: the server uses
# ws://livekit:7880 inside the network; browsers need wss://lk.example.com or ws://localhost:7880). Empty = LIVEKIT_URL.
LIVEKIT_PUBLIC_URL=
# Upper bound on Identities that are STARTING/READY/BUSY at once (each holds models in memory). Launch answers 409 beyond it.
# The Groq on-demand tier (~7,000 input tokens/min for qwen/qwen3.8-27b) supports about 1-2 conversations in total, shared with
# the Service Expert's key. A higher Groq tier or another OpenAI-compatible endpoint (LLM_BASE_URL/LLM_API_KEY) raises it.
SERVICE015_MAX_ACTIVE_IDENTITIES=2
# LLM request shaping (Groq rate limit): speculative generation off, endpointing delay, chat history kept per request,
# and bounded recreation of a session that closed on unrecoverable LLM errors.
# SERVICE015_PREEMPTIVE_GENERATION=false
# SERVICE015_ENDPOINTING_MIN_DELAY_S=0.6
# SERVICE015_MAX_HISTORY_TURNS=8
# SERVICE015_SESSION_RECOVERY_ATTEMPTS=5
# SERVICE015_SESSION_RECOVERY_BACKOFF_S=15
# Runtime worker log level (INFO|DEBUG; DEBUG adds transcripts and per-event tracing) for the size-rotated
# runtime-worker.rotating.log next to the database.
# SERVICE015_RUNTIME_LOG=INFO
# SERVICE015_RUNTIME_LOG_MAX_BYTES=5000000
# SERVICE015_RUNTIME_LOG_BACKUPS=5
# Turn text (turn_metrics.user_text/agent_text) older than this is blanked at API startup; timings are kept.
# SERVICE015_TRANSCRIPT_RETENTION_DAYS=30
# Moonshine STT model size (tiny|small|medium) and language.
MOONSHINE_ARCH=small
MOONSHINE_LANGUAGE=en
# Explicit-dispatch name the runtime worker registers under; the supervisor dispatches to it.
LIVEKIT_AGENT_NAME=service015-identity

# Voicebox TTS server.
VOICEBOX_URL=http://127.0.0.1:17493
VOICEBOX_TIMEOUT_S=30
# Chatterbox Turbo streaming sidecar (engine/). Preview timeout: CPU needs ~15-40 s for a short sentence.
VOICE_ENGINE_URL=http://127.0.0.1:17494
VOICE_ENGINE_TIMEOUT_S=120

# Service 014 telephony adapter: disabled | http | livekit_sip.
SERVICE014_MODE=disabled
# http mode (assumed contract): POST {SERVICE014_URL}/calls with bearer SERVICE014_API_KEY.
SERVICE014_URL=
SERVICE014_API_KEY=
# livekit_sip mode: outbound SIP trunk id on the LiveKit deployment above.
SERVICE014_SIP_TRUNK_ID=
# Comma-separated E.164 prefixes a dial may target, e.g. +91,+1415. Empty = deny all when SERVICE015_PUBLIC_URL is not local,
# allow all on localhost.
SERVICE014_ALLOWED_DESTINATIONS=

# ---- Engine sidecar (read by scripts/run_engine.* and the engine container, not by the API) ----
# CHATTERBOX_VARIANT=turbo            # turbo | turbo-nano (nano is ~3x faster on CPU, lower quality)
# VOICE_ENGINE_DEVICE=cpu             # cpu | cuda

# ---- docker compose only (see docker-compose.yml, deploy/EC2.md) ----
# Under compose an EMPTY LIVEKIT_PUBLIC_URL means ws://localhost:7880 (not LIVEKIT_URL): always set it for remote hosts.
# Voice stack profile: cpu | gpu (add ",sip" for the SIP gateway, ",tls" for Caddy).
COMPOSE_PROFILES=cpu
# Address LiveKit advertises in ICE candidates: 127.0.0.1 on a laptop, the instance's public IP on EC2.
LIVEKIT_NODE_IP=127.0.0.1
# Host interface the API port is published on (0.0.0.0 only behind a firewall/TLS front).
SERVICE015_BIND=127.0.0.1
# tls profile: two DNS names pointing at the instance.
SERVICE015_DOMAIN=
LIVEKIT_DOMAIN=
