# SAFI Service 015 - copy to .env and fill in. Never commit .env.

# API keys for the control plane: comma-separated "key:role" pairs.
# Roles: admin, operator, viewer (admin > operator > viewer).
SERVICE015_API_KEYS=change-me-admin:admin,change-me-operator:operator,change-me-viewer:viewer
# SQLite database file (parent directory is created automatically).
SERVICE015_DB_PATH=./data/service015.db
SERVICE015_HOST=127.0.0.1
SERVICE015_PORT=8015
# Externally reachable base URL of this service.
SERVICE015_PUBLIC_URL=http://localhost:8015

# OpenAI-compatible LLM endpoint.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# LiveKit server (dev defaults).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Voicebox TTS server.
VOICEBOX_URL=http://127.0.0.1:17493
